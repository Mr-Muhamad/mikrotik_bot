# Telegram
BOT_TOKEN=YOUR_BOT_TOKEN_HERE
ADMIN_IDS=YOUR_TELEGRAM_USER_ID

# Encryption key for password storage (REQUIRED)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=YOUR_ENCRYPTION_KEY_HERE

# File transfer server (replaces plaintext FTP)
# The IP/hostname the routers can reach to push/pull files from the bot
BOT_HOST=YOUR_BOT_IP_HERE
# Port for the file transfer HTTP server (default: 8729)
FILE_SERVER_PORT=8729
# Shared secret for file transfer auth (auto-generated if blank)
FILE_SERVER_SECRET=

# Enable full system backup in daily scheduler (default: false)
# When true, the daily scheduled backup also performs a full system backup.
# The full backup uses HTTP file transfer instead of FTP.
SCHEDULE_FULL_BACKUP=false
