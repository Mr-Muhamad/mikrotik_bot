{
  "include": ["bot", "core", "database", "utils", "pdf", "main.py", "config.py"],
  "exclude": [
    "**/__pycache__",
    "**/venv",
    "scripts",
    "tests",
    "**/node_modules",
    "alembic"
  ],
  "pythonVersion": "3.12",
  "typeCheckingMode": "standard",
  "extraPaths": [
    "C:/Users/Administrator/AppData/Local/Programs/Python/Python312/Lib/site-packages"
  ],
  "reportOptionalMemberAccess": "none",
